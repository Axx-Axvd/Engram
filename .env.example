# ───────── Engram backend (apps/api) ─────────
# Database (PostgreSQL + pgvector). Matches infra/docker-compose.yml defaults.
ENGRAM_DB_URL=postgresql+psycopg://engram:engram@localhost:5432/engram

# LLM generation provider: mock | anthropic | openai
ENGRAM_LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Embeddings provider: mock | local | openai
ENGRAM_EMBEDDING_PROVIDER=local
# Embedding vector dimension (must match the model / DB column).
ENGRAM_EMBEDDING_DIM=384

# CORS: comma-separated origins allowed to call the API (the Next.js dev server).
ENGRAM_CORS_ORIGINS=http://localhost:3000

# ───────── Engram frontend (apps/web) ─────────
# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ───────── Postgres (infra/docker-compose.yml) ─────────
POSTGRES_USER=engram
POSTGRES_PASSWORD=engram
POSTGRES_DB=engram
