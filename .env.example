# ───────── Engram backend (apps/api) ─────────
# Database (PostgreSQL + pgvector). Matches infra/docker-compose.yml (host port 5433).
ENGRAM_DB_URL=postgresql+psycopg://engram:engram@127.0.0.1:5433/engram

# LLM generation provider:
#   mock        - default, offline, deterministic (no tokens)
#   claude_code - real LLM via the subscription-authenticated Claude CLI (run: uv sync --extra llm)
ENGRAM_LLM_PROVIDER=mock
# Optional model override for claude_code (blank = your plan's default), e.g. claude-opus-4-8
# ENGRAM_LLM_MODEL=
# Direct-API providers (anthropic / openai) come later and would use their own keys:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Embeddings provider: mock (offline default) | local (fastembed; install the `local` extra)
ENGRAM_EMBEDDING_PROVIDER=mock
# Embedding vector dimension (must match the model / DB column). bge-small-en-v1.5 = 384.
ENGRAM_EMBEDDING_DIM=384

# Read-only GitHub source adapter. Optional for public repositories.
# ENGRAM_GITHUB_TOKEN=
ENGRAM_GITHUB_API_URL=https://api.github.com

# CORS: comma-separated origins allowed to call the API (the Next.js dev server).
ENGRAM_CORS_ORIGINS=http://localhost:3000

# ───────── Engram frontend (apps/web) ─────────
# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ───────── Postgres (infra/docker-compose.yml) ─────────
POSTGRES_USER=engram
POSTGRES_PASSWORD=engram
POSTGRES_DB=engram
